"""
Apple MAS Toolkit - Complete Analysis Walkthrough
==================================================

This notebook demonstrates a complete workflow for analyzing molecular marker
data in apple breeding programs using the Apple MAS Toolkit.

Contents:
1. Loading and exploring the marker database
2. Importing genotype data
3. Allele frequency analysis
4. Diversity metrics
5. Parent scoring and ranking
6. Finding complementary parent pairs
7. Generating publication-quality visualizations
"""

# %% [markdown]
# # Apple MAS Toolkit - Analysis Walkthrough
#
# This notebook demonstrates how to use the toolkit for a complete
# marker-assisted selection analysis in apple breeding.

# %%
import sys
sys.path.insert(0, "../src")

from apple_mas import (
    MarkerDatabase,
    DataParser,
    AlleleAnalyzer,
    ParentScorer,
    MarkerVisualizer,
)

# %%
# Step 1: Explore the Marker Database
# =====================================

db = MarkerDatabase()
print(db.summary())

# %%
# List all available markers
print("Available markers:")
for m in db.list_markers():
    info = db.get_marker(m)
    print(f"  {m:12s} | Chr {info.get('chromosome', '?'):2s} | {info['marker_type']:4s} | {info['trait']}")

# %%
# Explore a specific marker
info = db.get_marker("MYB10")
print(f"\nMarker: MYB10")
print(f"  Trait: {info['trait']}")
print(f"  Chromosome: {info['chromosome']}")
print(f"  Type: {info['marker_type']}")
print(f"\n  Alleles:")
for allele, defn in info["allele_definitions"].items():
    print(f"    {allele} bp: {defn['phenotype']} (frequency: {defn.get('frequency_in_ANABP', 'N/A')})")
print(f"\n  Breeding Notes: {info['breeding_notes']}")

# %%
# Search markers by keyword
print("Markers related to 'texture':")
for m in db.search_markers("texture"):
    print(f"  {m}: {db.get_marker(m)['trait']}")

# %%
# Step 2: Load Genotype Data
# ============================

parser = DataParser()

# Option A: Create sample dataset
df, raw = parser.create_sample_dataset()
print(f"Sample dataset: {df['sample_id'].nunique()} accessions, {df['marker'].nunique()} markers")
print(f"Total genotype records: {len(df)}")
print(f"\nMarkers in dataset:")
print(df.groupby("marker")["sample_id"].count().to_string())

# %%
# Option B: Load from CSV
# df = parser.from_csv("path/to/your/data.csv")

# Option C: Load from Excel
# df = parser.from_excel("path/to/your/data.xlsx")

# Option D: Load from wide-format CSV
# df = parser.from_wide_csv("path/to/wide_data.csv")

# Option E: Load from dictionary
# data = {
#     "S001": {"MYB10": "390:390", "RED_TE": "750", "ACS": "200:341"},
#     "S002": {"MYB10": "390:490", "RED_TE": "NB", "ACS": "341:341"},
# }
# df = parser.from_dict(data)

# %%
# Step 3: Allele Frequency Analysis
# ====================================

analyzer = AlleleAnalyzer()

# Analyze each marker
for marker in sorted(df["marker"].unique()):
    freq = analyzer.allele_frequencies(df, marker)
    print(f"\n{marker} allele frequencies:")
    allele_col = freq.columns[0]
    for _, row in freq.iterrows():
        print(f"  {str(row[allele_col]):>8s}: {row['frequency']:.4f} ({row['count']} alleles)")

# %%
# Step 4: Genotype Distribution
# ===============================

for marker in sorted(df["marker"].unique()):
    geno = analyzer.genotype_frequencies(df, marker)
    print(f"\n{marker} genotype distribution:")
    for _, row in geno.iterrows():
        print(f"  {str(row['genotype']):>12s}: {row['count']:3d} ({row['percentage']:.1f}%)")

# %%
# Step 5: Diversity Metrics
# ===========================

print("\nCross-Marker Diversity Summary:")
print("=" * 70)
cross = analyzer.cross_marker_summary(df)
print(cross.to_string(index=False))

# %%
# Step 6: Hardy-Weinberg Test (for biallelic markers)
# =====================================================

print("\nHardy-Weinberg Equilibrium Tests:")
print("=" * 50)
for marker in ["RED_TE", "ACS", "ACO"]:
    hwe = analyzer.hardy_weinberg_test(df, marker)
    if hwe["chi2"] is not None:
        status = "IN HWE" if hwe["in_hwe"] else "DEVIATES FROM HWE"
        print(f"\n{marker}: chi2 = {hwe['chi2']:.4f}, p = {hwe['p_value']:.4f} ({status})")

# %%
# Step 7: Parent Scoring and Ranking
# =====================================

scorer = ParentScorer()

# List available breeding profiles
print("Available breeding profiles:")
print(scorer.list_profiles().to_string(index=False))

# %%
# Score a single accession
sample = df["sample_id"].iloc[0]
result = scorer.score_accession(df, sample)
print(f"\nDetailed score for {sample}:")
print(f"  Total Score: {result['total_score']:.4f}")
print(f"  Markers scored: {result['n_markers_scored']}")
print(f"\n  Per-trait scores:")
for trait, ts in result["trait_scores"].items():
    print(f"    {trait:30s}: {ts['raw_score']:.2f} (avg: {ts['avg_score']:.2f})")
print(f"\n  Per-marker scores:")
for marker, ms in result["marker_scores"].items():
    print(f"    {marker:12s}: {ms['genotype']:>12s} -> {ms['score']}/{ms['max']} (norm: {ms['normalized']:.2f})")

# %%
# Rank all accessions
for profile_name in ["premium_table", "balanced", "juice_cider"]:
    ranked = scorer.rank_accessions(df, profile=profile_name, top_n=10)
    print(f"\nTop 10 Accessions ({profile_name} profile):")
    print(ranked[["sample_id", "total_score"]].to_string())

# %%
# Step 8: Find Complementary Parent Pairs
# ==========================================

pairs = scorer.find_complementary_parents(df, n_pairs=10)
print("\nTop 10 Complementary Parent Pairs:")
print(pairs.to_string())

# %%
# Step 9: Generate Visualizations
# ==================================

viz = MarkerVisualizer(dpi=150)

# Allele frequency plots for each marker
for marker in sorted(df["marker"].unique()):
    viz.allele_frequency_plot(
        df, marker,
        save_path=f"plots/{marker}_allele_frequency.png"
    )
    print(f"  Saved: plots/{marker}_allele_frequency.png")

# Multi-marker comparison
viz.multi_marker_frequency(df, save_path="plots/all_markers_frequency.png")
print("  Saved: plots/all_markers_frequency.png")

# Genotype heatmap
viz.genotype_heatmap(df, save_path="plots/genotype_heatmap.png")
print("  Saved: plots/genotype_heatmap.png")

# Sample composition
viz.sample_composition_chart(df, save_path="plots/sample_composition.png")
print("  Saved: plots/sample_composition.png")

# Parent ranking
ranked = scorer.rank_accessions(df, profile="balanced")
viz.ranking_barplot(ranked, save_path="plots/parent_ranking.png")
print("  Saved: plots/parent_ranking.png")

# Trait radar comparison
top_accessions = ranked["sample_id"].head(4).tolist()
viz.trait_score_radar(df, top_accessions, save_path="plots/trait_radar.png")
print("  Saved: plots/trait_radar.png")

# %%
# Summary
# ========
#
# This notebook demonstrated the complete Apple MAS Toolkit workflow:
#
# 1. **Marker Database**: Queried 8 molecular markers with allele definitions
# 2. **Data Loading**: Parsed genotype data from multiple formats
# 3. **Allele Analysis**: Calculated frequencies, PIC, heterozygosity, HWE
# 4. **Parent Scoring**: Ranked accessions using 5 breeding profiles
# 5. **Parent Pairs**: Identified complementary crossing combinations
# 6. **Visualizations**: Generated 6 types of publication-quality plots
#
# For more details, see:
# - README.md for quick start guide
# - docs/marker_reference.md for marker details
# - docs/getting_started.md for installation and usage
