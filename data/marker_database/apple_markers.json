{
  "version": "1.0.0",
  "description": "Apple Molecular Marker Database for Marker-Assisted Selection (MAS)",
  "organism": "Malus domestica Borkh.",
  "markers": {
    "MYB10": {
      "full_name": "MdMYB10",
      "trait": "Flesh Color",
      "trait_category": "color",
      "chromosome": 9,
      "marker_type": "SSR",
      "probe_type": "fluorescent",
      "dye": "HEX",
      "primer_sequences": {
        "forward": "/5HEX/GGAGGGGAATGAAGAAGAGG",
        "reverse": "TCCACAGAAGCAAACACTGAC"
      },
      "allele_sizes_bp": [390, 490],
      "allele_definitions": {
        "390": {
          "phenotype": "White/green flesh",
          "genotype_description": "Homozygous 390:390",
          "anthocyanin_level": "low",
          "frequency_in_ANABP": 0.9792,
          "desirability": "common"
        },
        "490": {
          "phenotype": "Red/pink flesh",
          "genotype_description": "Associated with red flesh trait",
          "anthocyanin_level": "high",
          "frequency_in_ANABP": 0.0208,
          "desirability": "desirable"
        }
      },
      "genotype_interpretation": {
        "390:390": {"phenotype": "White/green flesh", "risk": "none"},
        "390:490": {"phenotype": "Red/pink flesh (heterozygous)", "risk": "none"},
        "490:490": {"phenotype": "Deep red flesh (homozygous)", "risk": "none"}
      },
      "notes": "MYB10 is an R2R3-MYB transcription factor regulating anthocyanin biosynthesis. The 490 bp allele activates genes involved in red pigmentation of flesh.",
      "references": [
        "Espley et al., 2007, Plant Journal",
        "Chagné et al., 2013, Plant Physiology",
        "Bars-Cortina et al., 2017, J Agric Food Chem"
      ],
      "breeding_notes": "Red flesh is rare in commercial germplasm. Heterozygous 390:490 accessions are valuable breeding resources. Environmental conditions (light, temperature) influence expression."
    },
    "RED_TE": {
      "full_name": "Red TE (Transposable Element)",
      "trait": "Skin Color",
      "trait_category": "color",
      "chromosome": 9,
      "marker_type": "SCAR",
      "probe_type": "non-fluorescent",
      "primer_sequences": {
        "forward": "/5HEX/GGTCACCCAACCCACACTGGGCCTTG",
        "reverse": "CGGCCGCAATCGCAAGACGCAGA"
      },
      "allele_sizes_bp": [750],
      "allele_definitions": {
        "750": {
          "phenotype": "Red skin",
          "description": "Presence of 750 bp band indicates RED TE insertion in MdMYB10 promoter",
          "frequency_in_ANABP": 0.6406,
          "desirability": "desirable"
        },
        "NB": {
          "phenotype": "Non-red skin",
          "description": "No band (absence of 750 bp fragment)",
          "frequency_in_ANABP": 0.3333,
          "desirability": "varies"
        }
      },
      "genotype_interpretation": {
        "750": {"phenotype": "Red skin", "zygosity_note": "Binary result - cannot distinguish homozygous from heterozygous"},
        "NB": {"phenotype": "Non-red skin (green/yellow)"}
      },
      "notes": "RED TE targets a transposable element insertion within the MdMYB10 promoter region. The insertion boosts MdMYB10 expression, increasing anthocyanin production for red skin pigmentation. This is a dominant marker producing binary (present/absent) results.",
      "limitations": [
        "Cannot distinguish homozygous (750/750) from heterozygous (750/NB) genotypes",
        "Does not predict intensity of red pigmentation",
        "Environmental factors (light, temperature) affect final skin color expression"
      ],
      "references": [
        "Chagné et al., 2013",
        "Zhang et al., 2019, Nature Communications",
        "Moriya et al., 2017, Euphytica",
        "Wang et al., 2023, Horticulturae"
      ],
      "breeding_notes": "Simple, cost-effective, reliable for large-scale screening. For zygosity information, use dual-band markers (Red_TE_Pos_F1 / Red_TE_Null_F2). High temperatures can reduce anthocyanin accumulation even with 750 bp allele."
    },
    "MA_INDEL": {
      "full_name": "Ma Indel (Ma locus Insertion-Deletion)",
      "trait": "Fruit Acidity",
      "trait_category": "acidity",
      "chromosome": 16,
      "marker_type": "SCAR",
      "probe_type": "fluorescent",
      "dye": "HEX",
      "primer_sequences": {
        "forward": "/5HEX/AAATGAACAGGACCCAGACG",
        "reverse": "ACGACTCCAATCCAACATCC"
      },
      "allele_sizes_bp": [364, 382, 387, 402, 409, 452, 456, 464],
      "primary_alleles": [409, 456],
      "allele_definitions": {
        "387": {"phenotype": "Rare variant", "acidity_effect": "variable", "frequency_in_ANABP": 0.0625, "desirability": "needs_characterization"},
        "402": {"phenotype": "Rare variant", "acidity_effect": "variable", "frequency_in_ANABP": 0.0625, "desirability": "needs_characterization"},
        "409": {"phenotype": "High acidity", "acidity_effect": "high malic acid", "frequency_in_ANABP": 0.08, "desirability": "desirable_for_tart"},
        "452": {"phenotype": "Variable acidity", "acidity_effect": "intermediate", "frequency_in_ANABP": 0.0521, "desirability": "needs_characterization"},
        "456": {"phenotype": "Low acidity", "acidity_effect": "low malic acid", "frequency_in_ANABP": 0.10, "desirability": "desirable_for_sweet"}
      },
      "genotype_interpretation": {
        "409:409": {"phenotype": "High acidity", "flavor": "Tart"},
        "409:456": {"phenotype": "Intermediate acidity", "flavor": "Balanced"},
        "456:456": {"phenotype": "Low acidity", "flavor": "Sweet"},
        "409:452": {"phenotype": "Intermediate acidity", "flavor": "Variable"},
        "387:402": {"phenotype": "Variable - rare alleles", "flavor": "Unknown"}
      },
      "notes": "The Ma locus is defined in a 150 kb region containing 44 predicted genes on chromosome 16. Encodes aluminum-activated malate transporters (ALMT) that control malic acid accumulation. A natural truncation mutation in one of these genes is associated with low fruit acidity.",
      "references": [
        "Bai et al., 2012, Mol Genet Genomics",
        "Xu et al., 2012, Mol Breeding",
        "Bianco et al., 2016, Plant Journal",
        "Peace et al., 2019, Horticulture Research",
        "Zheng et al., 2023, Plant Physiology"
      ],
      "breeding_notes": "409 bp allele = higher malic acid (tart flavor, good for cider). 456 bp allele = lower acidity (sweet). Rare alleles (387, 402, 452) need phenotypic validation. Environmental factors (temperature, light, soil) can modify expression."
    },
    "BP16": {
      "full_name": "BP16-indel",
      "trait": "Bitter Pit Susceptibility",
      "trait_category": "disease_resistance",
      "chromosome": 8,
      "marker_type": "SSR",
      "probe_type": "fluorescent",
      "dye": "FAM",
      "primer_sequences": {
        "forward": "/5HEX/TGCGATGTTAGAACGAGAGC",
        "reverse": "TTGGAAACTGGATTTTATTTGC"
      },
      "allele_sizes_bp": [203, 206, 368],
      "allele_definitions": {
        "203": {
          "phenotype": "Lower bitter pit susceptibility (resistance)",
          "mechanism": "Associated with favorable calcium distribution",
          "frequency_in_ANABP": 0.22,
          "desirability": "desirable"
        },
        "206": {
          "phenotype": "Intermediate susceptibility",
          "frequency_in_ANABP": 0.06,
          "desirability": "acceptable"
        },
        "368": {
          "phenotype": "Higher bitter pit susceptibility",
          "mechanism": "Associated with impaired calcium uptake/distribution",
          "frequency_in_ANABP": 0.45,
          "desirability": "undesirable"
        }
      },
      "genotype_interpretation": {
        "203:203": {"phenotype": "Lower susceptibility", "risk_level": "low"},
        "203:206": {"phenotype": "Lower susceptibility", "risk_level": "low"},
        "203:368": {"phenotype": "Moderate susceptibility", "risk_level": "moderate"},
        "206:206": {"phenotype": "Moderate susceptibility", "risk_level": "moderate"},
        "206:368": {"phenotype": "Moderate-high susceptibility", "risk_level": "moderate-high"},
        "368:368": {"phenotype": "High susceptibility", "risk_level": "high"}
      },
      "notes": "Located on chromosome 8. Associated with calcium uptake and distribution within fruit. Bitter pit is a physiological disorder characterized by dark, sunken lesions on the fruit surface.",
      "references": [
        "Buti et al., 2015, Mol Breeding",
        "Celton et al., 2009, BMC Research Notes",
        "Thapa et al., 2021, Plant Genome"
      ],
      "breeding_notes": "Accessions with 368:368 genotype require enhanced calcium management (e.g., CaCl2 sprays). The 203:203 genotype provides the best genetic resistance. Combine with BP13 analysis for comprehensive bitter pit risk assessment."
    },
    "BP13": {
      "full_name": "BP13-SSR",
      "trait": "Bitter Pit Susceptibility",
      "trait_category": "disease_resistance",
      "chromosome": 8,
      "marker_type": "SSR",
      "probe_type": "fluorescent",
      "dye": "FAM",
      "primer_sequences": {
        "forward": "/5HEX/CCTGTTCGCAAACAAGAAGG",
        "reverse": "GCGTAGTCAATCAAAACATTCG"
      },
      "allele_sizes_bp": [222, 224, 226, 232, 234, 236, 242, 250, 252, 260],
      "allele_definitions": {
        "224": {"phenotype": "Reduced bitter pit risk", "frequency_in_ANABP": 0.1042, "desirability": "desirable"},
        "232": {"phenotype": "Higher bitter pit susceptibility", "frequency_in_ANABP": 0.3021, "desirability": "undesirable"},
        "250": {"phenotype": "Variable susceptibility", "frequency_in_ANABP": 0.15, "desirability": "intermediate"},
        "252": {"phenotype": "Variable susceptibility", "frequency_in_ANABP": 0.05, "desirability": "intermediate"}
      },
      "genotype_interpretation": {
        "224:232": {"phenotype": "Moderate susceptibility"},
        "232:250": {"phenotype": "Moderate-high susceptibility (most common)"},
        "226:236": {"phenotype": "Lower susceptibility", "risk_level": "low"}
      },
      "notes": "Located on chromosome 8 alongside BP16. Wide range of allele sizes (222-260 bp) indicates substantial genetic variation. The 232 bp allele is often linked to higher susceptibility.",
      "references": [
        "Buti et al., 2015, Mol Breeding",
        "Thapa et al., 2021, Plant Genome"
      ],
      "breeding_notes": "Use in combination with BP16 for comprehensive bitter pit assessment. Non-232 bp combinations suggest reduced risk. Field validation recommended."
    },
    "ACS": {
      "full_name": "Md-ACS1 (1-aminocyclopropane-1-carboxylic acid synthase)",
      "trait": "Fruit Texture / Ethylene Production",
      "trait_category": "texture",
      "chromosome": 10,
      "marker_type": "SCAR",
      "probe_type": "non-fluorescent",
      "primer_sequences": {
        "forward": "/5HEX/CGAGGTTGACTCAAATCAAAAC",
        "reverse": "GCTGATGAATGAGTCGTTGC"
      },
      "allele_sizes_bp": [200, 341],
      "allele_definitions": {
        "200": {
          "phenotype": "Md-ACS1-1 allele",
          "effect": "Standard ethylene production",
          "firmness": "Standard",
          "frequency_in_ANABP": 0.38,
          "desirability": "standard"
        },
        "341": {
          "phenotype": "Md-ACS1-2 allele",
          "effect": "Reduced ethylene production",
          "firmness": "Increased (longer shelf life)",
          "frequency_in_ANABP": 0.38,
          "desirability": "desirable"
        }
      },
      "genotype_interpretation": {
        "200:200": {"phenotype": "Standard ethylene production", "shelf_life": "Standard"},
        "200:341": {"phenotype": "Intermediate ethylene production", "shelf_life": "Slightly extended", "frequency": "Most common (57.81%)"},
        "341:341": {"phenotype": "Reduced ethylene production", "shelf_life": "Extended", "firmness": "Firmer fruit"}
      },
      "notes": "SCAR marker targeting the Md-ACS1 gene involved in ethylene biosynthesis. The ACS1-2 allele (341 bp) is associated with lower ethylene levels during storage, leading to firmer apples with longer shelf life.",
      "references": [
        "Sunako et al., 1999, Plant Physiology",
        "Costa et al., 2005, Euphytica",
        "Zhu & Barritt, 2008, Tree Genetics & Genomes"
      ],
      "breeding_notes": "The 341 bp allele is favorable for breeding apples with extended shelf life. Combine with ACO and Md-PG1 for comprehensive texture profiling."
    },
