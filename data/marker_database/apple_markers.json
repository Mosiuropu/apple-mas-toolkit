    "Vf_SCAR": {
      "full_name": "Vf/Rvi6 SCAR (Venturia inaequalis resistance)",
      "trait": "Apple Scab Resistance",
      "trait_category": "disease_resistance",
      "chromosome": 1,
      "lg": "LG01",
      "marker_type": "SCAR",
      "probe_type": "non-fluorescent",
      "primer_sequences": {
        "forward": "ATGAGAAGAAATCAATGGAATCG",
        "reverse": "TAAGTATCCCAAATTGCATCTGA"
      },
      "allele_sizes_bp": [200, 280],
      "allele_definitions": {
        "200": {
          "phenotype": "Vf allele present (scab resistance)",
          "mechanism": "Contains Rvi6 (Vf) R-gene encoding HMA domain protein",
          "desirability": "desirable"
        },
        "NB": {
          "phenotype": "Vf allele absent (scab susceptible)",
          "description": "No amplification of resistance-associated band",
          "desirability": "undesirable"
        }
      },
      "genotype_interpretation": {
        "200": {"phenotype": "Resistance allele present (dominant marker)", "resistance": "Vf-mediated resistance to apple scab"},
        "NB": {"phenotype": "No resistance allele detected", "resistance": "Susceptible to Venturia inaequalis races overcoming Vf"}
      },
      "notes": "The Vf locus (Rvi6) on chromosome 1 was introgressed from Malus micromalus and confers broad-spectrum resistance to apple scab (Venturia inaequalis). This SCAR marker detects the presence/absence of the resistance allele. Note: some races of V. inaequalis can overcome Vf resistance, so pyramiding with additional R-genes is recommended.",
      "limitations": [
        "Dominant marker; cannot distinguish homozygous from heterozygous",
        "Does not confer resistance to all V. inaequalis races",
        "Field validation under high disease pressure recommended"
      ],
      "references": [
        "Gianfranceschi et al., 1999, Theor Appl Genet",
        "Seglias et al., 1998, Plant Breeding",
        "Bus et al., 2005, Theor Appl Genet",
        "Calenge & Durel, 2006, Theor Appl Genet"
      ],
      "breeding_notes": "Vf is the most widely deployed apple scab resistance gene in breeding programs. For durable resistance, pyramid with other Rvi loci (e.g., Rvi2, Rvi4, Rvi5, Rvi15). Marker-assisted backcrossing is the standard strategy for introgressing Vf into elite cultivars."
    },
