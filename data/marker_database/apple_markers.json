  "markers": {
    "MYB10": {
      "full_name": "MdMYB10",
      "trait": "Flesh Color",
      "trait_category": "color",
      "chromosome": 9,
      "lg": "LG09",
      "marker_type": "SSR",
      "probe_type": "fluorescent",
      "dye": "HEX",
      "primer_sequences": {
        "forward": "/5HEX/GGAGGGGAATGAAGAAGAGG",
        "reverse": "TCCACAGAAGCAAACACTGAC"
      },
      "allele_sizes_bp": [390, 490],
      "allele_definitions": {
        "390": {
          "phenotype": "White/green flesh",
          "genotype_description": "Homozygous 390:390",
          "anthocyanin_level": "low",
          "desirability": "common"
        },
        "490": {
          "phenotype": "Red/pink flesh",
          "genotype_description": "Associated with red flesh trait",
          "anthocyanin_level": "high",
          "desirability": "desirable"
        }
      },
      "genotype_interpretation": {
        "390:390": {"phenotype": "White/green flesh", "risk": "none"},
        "390:490": {"phenotype": "Red/pink flesh (heterozygous)", "risk": "none"},
        "490:490": {"phenotype": "Deep red flesh (homozygous)", "risk": "none"}
      },
      "notes": "MYB10 is an R2R3-MYB transcription factor regulating anthocyanin biosynthesis. The 490 bp allele activates genes involved in red pigmentation of flesh.",
      "references": [
        "Espley et al., 2007, Plant Journal",
        "Chagne et al., 2013, Plant Physiology",
        "Bars-Cortina et al., 2017, J Agric Food Chem"
      ],
      "breeding_notes": "Red flesh is rare in commercial germplasm. Heterozygous 390:490 accessions are valuable breeding resources. Environmental conditions (light, temperature) influence expression."
    },
    "RED_TE": {
      "full_name": "Red TE (Transposable Element)",
      "trait": "Skin Color",
      "trait_category": "color",
      "chromosome": 9,
      "lg": "LG09",
      "marker_type": "SCAR",
      "probe_type": "non-fluorescent",
      "primer_sequences": {
        "forward": "/5HEX/GGTCACCCAACCCACACTGGGCCTTG",
        "reverse": "CGGCCGCAATCGCAAGACGCAGA"
      },
      "allele_sizes_bp": [750],
      "allele_definitions": {
        "750": {
          "phenotype": "Red skin",
          "description": "Presence of 750 bp band indicates RED TE insertion in MdMYB10 promoter",
          "desirability": "desirable"
        },
        "NB": {
          "phenotype": "Non-red skin",
          "description": "No band (absence of 750 bp fragment)",
          "desirability": "varies"
        }
      },
      "genotype_interpretation": {
        "750": {"phenotype": "Red skin", "zygosity_note": "Binary result - cannot distinguish homozygous from heterozygous"},
        "NB": {"phenotype": "Non-red skin (green/yellow)"}
      },
      "notes": "RED TE targets a transposable element insertion within the MdMYB10 promoter region. The insertion boosts MdMYB10 expression, increasing anthocyanin production for red skin pigmentation. This is a dominant marker producing binary (present/absent) results.",
      "limitations": [
        "Cannot distinguish homozygous (750/750) from heterozygous (750/NB) genotypes",
        "Does not predict intensity of red pigmentation",
        "Environmental factors (light, temperature) affect final skin color expression"
      ],
      "references": [
        "Chagne et al., 2013",
        "Zhang et al., 2019, Nature Communications",
        "Moriya et al., 2017, Euphytica",
        "Wang et al., 2023, Horticulturae"
      ],
      "breeding_notes": "Simple, cost-effective, reliable for large-scale screening. For zygosity information, use dual-band markers (Red_TE_Pos_F1 / Red_TE_Null_F2). High temperatures can reduce anthocyanin accumulation even with 750 bp allele."
    },
    "MA_INDEL": {
      "full_name": "Ma Indel (Ma locus Insertion-Deletion)",
      "trait": "Fruit Acidity",
      "trait_category": "acidity",
      "chromosome": 16,
      "lg": "LG16",
      "marker_type": "SCAR",
      "probe_type": "fluorescent",
      "dye": "HEX",
      "primer_sequences": {
        "forward": "/5HEX/AAATGAACAGGACCCAGACG",
        "reverse": "ACGACTCCAATCCAACATCC"
      },
      "allele_sizes_bp": [364, 382, 387, 402, 409, 452, 456, 464],
      "primary_alleles": [409, 456],
      "allele_definitions": {
        "387": {"phenotype": "Rare variant", "acidity_effect": "variable", "desirability": "needs_characterization"},
        "402": {"phenotype": "Rare variant", "acidity_effect": "variable", "desirability": "needs_characterization"},
        "409": {"phenotype": "High acidity", "acidity_effect": "high malic acid", "desirability": "desirable_for_tart"},
        "452": {"phenotype": "Variable acidity", "acidity_effect": "intermediate", "desirability": "needs_characterization"},
        "456": {"phenotype": "Low acidity", "acidity_effect": "low malic acid", "desirability": "desirable_for_sweet"}
      },
      "genotype_interpretation": {
        "409:409": {"phenotype": "High acidity", "flavor": "Tart"},
        "409:456": {"phenotype": "Intermediate acidity", "flavor": "Balanced"},
        "456:456": {"phenotype": "Low acidity", "flavor": "Sweet"},
        "409:452": {"phenotype": "Intermediate acidity", "flavor": "Variable"},
        "387:402": {"phenotype": "Variable - rare alleles", "flavor": "Unknown"}
      },
      "notes": "The Ma locus is defined in a 150 kb region containing 44 predicted genes on chromosome 16. Encodes aluminum-activated malate transporters (ALMT) that control malic acid accumulation. A natural truncation mutation in one of these genes is associated with low fruit acidity.",
      "references": [
        "Bai et al., 2012, Mol Genet Genomics",
        "Xu et al., 2012, Mol Breeding",
        "Bianco et al., 2016, Plant Journal",
        "Peace et al., 2019, Horticulture Research",
        "Zheng et al., 2023, Plant Physiology"
      ],
      "breeding_notes": "409 bp allele = higher malic acid (tart flavor, good for cider). 456 bp allele = lower acidity (sweet). Rare alleles (387, 402, 452) need phenotypic validation. Environmental factors (temperature, light, soil) can modify expression."
    },
