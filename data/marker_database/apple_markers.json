    },
    "MD_PG1": {
      "full_name": "Md-PG1-10kDa SSR (Polygalacturonase)",
      "trait": "Fruit Texture / Firmness",
      "trait_category": "texture",
      "chromosome": 10,
      "marker_type": "SSR",
      "probe_type": "fluorescent",
      "dye": "FAM",
      "primer_sequences": {
        "forward": "/56-FAM/TTTCTTCCTTGGGTTTTTGG",
        "reverse": "CGAAGCCACTCTCCTTCTCC"
      },
      "allele_sizes_bp": [177, 180, 185, 289, 292, 298],
      "allele_definitions": {
        "289": {"phenotype": "Favorable for firmness", "frequency_in_ANABP": 0.20, "desirability": "desirable"},
        "292": {"phenotype": "Favorable for firmness", "frequency_in_ANABP": 0.20, "desirability": "desirable"},
        "298": {"phenotype": "Softer texture (linked to polygalacturonase activity)", "frequency_in_ANABP": 0.25, "desirability": "less_desirable"}
      },
      "genotype_interpretation": {
        "289:292": {"phenotype": "Firm fruit", "cell_wall": "Intact", "frequency": "Most common (20.83%)"},
