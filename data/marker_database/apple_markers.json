  },
  "trait_groups": {
    "color": {
      "markers": ["MYB10", "RED_TE"],
      "description": "Skin and flesh color traits controlled by anthocyanin biosynthesis pathways"
    },
    "texture": {
      "markers": ["ACS", "ACO", "MD_PG1"],
      "description": "Fruit texture traits controlled by ethylene production and cell wall degradation"
    },
    "acidity": {
      "markers": ["MA_INDEL"],
      "description": "Fruit acidity controlled by malate transporter genes"
    },
    "disease_resistance": {
      "markers": ["BP16", "BP13"],
      "description": "Bitter pit susceptibility markers related to calcium metabolism"
    }
  },
  "chromosomal_locations": {
    "8": ["BP16", "BP13"],
    "9": ["MYB10", "RED_TE"],
    "10": ["ACS", "ACO", "MD_PG1"],
    "16": ["MA_INDEL"]
  },
  "methodology": {
    "PCR_conditions": {
      "total_volume_ul": 25,
      "components": {
        "PCR_buffer_1x": true,
        "MgCl2_mM": 1.5,
        "dNTPs_uM": 200,
        "primer_each_uM": 0.5,
        "Taq_polymerase_U": 1,
        "template_DNA_ng": 50
      },
      "thermal_cycling": {
        "initial_denaturation": {"temp_C": 95, "time_min": 5},
        "cycles": 30,
        "denaturation": {"temp_C": 94, "time_sec": 30},
        "annealing": {"temp_C": 55, "time_sec": 30},
        "extension": {"temp_C": 72, "time_sec": 60},
        "final_extension": {"temp_C": 72, "time_min": 10}
      }
    },
    "fragment_analysis": {
      "platform": "ABI 3130xl Genetic Analyzer",
      "software": "GeneMapper 5.0",
      "size_standard": "GeneScan 600 LIZ",
      "denaturation": {"temp_C": 95, "time_min": 5}
    },
    "gel_electrophoresis": {
      "agarose_pct": [1.0, 1.5],
      "buffer": "1x TAE",
      "voltage_V": "90-110",
      "time_min": 60,
      "stain": "Ethidium bromide 0.5 ug/mL"
    }
  }
}
